msgctxt "Addons::name::vendor_card"
msgid "Vendor card"
msgstr "Картка продавця"

msgctxt "Addons::description::vendor_card"
msgid "A vendor block with a native modal and a custom anchored popup."
msgstr "Блок продавця зі штатним модальним вікном і власним попапом."

msgctxt "Languages::vendor_card"
msgid "Vendor card"
msgstr "Картка продавця"

msgctxt "Languages::vendor_card_company_id"
msgid "Vendor ID (0 = current vendor or product page)"
msgstr "ID продавця (0 = поточна сторінка продавця або товару)"

msgctxt "Languages::vendor_card.company_id_hint"
msgid "Use a positive vendor ID on the homepage. Use 0 on a vendor or product detail page. The block is hidden when no active vendor is available."
msgstr "На головній сторінці вкажіть ID продавця. На сторінці продавця або товару використайте 0. Блок приховується, якщо активного продавця не знайдено."

